{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gauley-flush",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "FEEDBACK", "class_name": "Feedback" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Feedback"] }
  ],
  "vars": {
    // Set to your OAuth Web client id to enable "Continue with Google". Empty = hidden.
    "GOOGLE_CLIENT_ID": "57429248559-cb07d4hmcf84ec5gdka5bjj3nahsao8g.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
